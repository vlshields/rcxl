PKG_CPPFLAGS = -Ilibdeflate -DMINIZ_NO_ARCHIVE_WRITING_APIS -DMINIZ_NO_ZLIB_COMPATIBLE_NAMES -DMINIZ_DISABLE_ZIP_READER_CRC32_CHECKS -D_FILE_OFFSET_BITS=64 -D_LARGEFILE64_SOURCE

LIBDEFLATE_OBJS = libdeflate/lib/deflate_decompress.o libdeflate/lib/utils.o \
	libdeflate/lib/x86/cpu_features.o libdeflate/lib/arm/cpu_features.o

OBJECTS = init.o miniz.o read_xlsx.o $(LIBDEFLATE_OBJS)

# Rtools ships winpthreads
PKG_LIBS = -lpthread
